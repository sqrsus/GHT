<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <!-- 关掉隐式 using：本工程同时启用 WPF 与 WinForms，隐式引入 System.Windows.Forms 会让
         MessageBox / Application 与 WPF 同名类型二义。基础命名空间改由 GlobalUsings.cs 显式声明。 -->
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>12.0</LangVersion>
    <AssemblyName>GHT</AssemblyName>
    <RootNamespace>GHT</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- 用正斜杠：本地也会在 WSL/Linux 上用 EnableWindowsTargeting 交叉编译，反斜杠在那里解析不了 -->
    <ApplicationIcon>Resources/app.ico</ApplicationIcon>
    <Version>1.5.0</Version>
    <AssemblyVersion>1.5.0.0</AssemblyVersion>
    <FileVersion>1.5.0.0</FileVersion>
    <Product>GHT - GitHub 访问加速</Product>
    <Company>GHT</Company>
    <Copyright>Copyright (c) 2026 sqrsus</Copyright>
    <NeutralLanguage>zh-CN</NeutralLanguage>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <DebugType>portable</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\public-dns-servers.json">
      <LogicalName>GHT.Resources.public-dns-servers.json</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <!-- 同一份 ico 既作为 exe 的 Win32 图标（上面的 ApplicationIcon），也作为 WPF 资源：
         窗口标题栏与托盘都用它，避免出现「任务栏一个图标、托盘另一个图标」。 -->
    <Resource Include="Resources\app.ico" />
  </ItemGroup>

</Project>
