<Window x:Class="GHT.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GHT - GitHub 访问加速"
        Height="720" Width="960"
        MinHeight="560" MinWidth="760"
        WindowStartupLocation="CenterScreen"
        FontFamily="Microsoft YaHei UI" FontSize="13">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 状态条 -->
        <Border Grid.Row="0" Background="#F4F5F7" CornerRadius="6" Padding="12,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Ellipse x:Name="StatusDot" Grid.Column="0" Width="10" Height="10"
                         Fill="#B0B4BA" VerticalAlignment="Center" />

                <TextBlock x:Name="StatusText" Grid.Column="1" Margin="8,0,0,0"
                           VerticalAlignment="Center" Text="未启动" />

                <TextBlock Grid.Column="2" Text="端口" VerticalAlignment="Center" Margin="8,0,6,0" />
                <TextBox x:Name="PortBox" Grid.Column="3" Width="72" Text="7890"
                         VerticalContentAlignment="Center" />

                <Button x:Name="StartStopButton" Grid.Column="4" Content="启动加速"
                        Width="96" Height="30" Margin="10,0,0,0" />

                <Button x:Name="HideButton" Grid.Column="5" Content="最小化到托盘"
                        Height="30" Margin="8,0,0,0" Padding="10,0" />
            </Grid>
        </Border>

        <!-- 主体：左白名单 / 右加速池 -->
        <Grid Grid.Row="1" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="260" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" MinWidth="320" />
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Column="0" Header="加速域名白名单（逗号或换行分隔，支持 * 通配）">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBox x:Name="WhitelistBox" Grid.Row="0"
                             AcceptsReturn="True" TextWrapping="NoWrap"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             FontFamily="Consolas" FontSize="12" />

                    <WrapPanel Grid.Row="1" Margin="0,8,0,0">
                        <Button x:Name="SaveWhitelistButton" Content="保存并生效" Padding="10,4" />
                        <Button x:Name="RestoreDefaultButton" Content="恢复默认" Padding="10,4" Margin="8,0,0,0" />
                        <CheckBox x:Name="AccelCheck" Content="启用 DNS 加速" Margin="16,0,0,0"
                                  VerticalAlignment="Center" IsChecked="True" />
                    </WrapPanel>
                </Grid>
            </GroupBox>

            <GroupBox Grid.Column="2" Header="DNS 加速池">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="PoolStatusText" Grid.Row="0" TextWrapping="Wrap"
                               Text="加速池为空，请先扫描" />

                    <WrapPanel Grid.Row="1" Margin="0,8,0,0">
                        <TextBlock Text="来源域名" VerticalAlignment="Center" />
                        <TextBox x:Name="ScanDomainBox" Width="160" Margin="6,0,0,0"
                                 Text="github.com" VerticalContentAlignment="Center" />
                        <Button x:Name="ScanButton" Content="扫描" Padding="10,4" Margin="8,0,0,0" />
                        <Button x:Name="ApplyScanButton" Content="应用结果" Padding="10,4" Margin="6,0,0,0" IsEnabled="False" />
                        <Button x:Name="CancelScanButton" Content="取消" Padding="10,4" Margin="6,0,0,0" IsEnabled="False" />
                        <Button x:Name="RemovePoolButton" Content="移除选中" Padding="10,4" Margin="6,0,0,0" />
                        <Button x:Name="ClearPoolButton" Content="清空" Padding="10,4" Margin="6,0,0,0" />
                    </WrapPanel>

                    <ProgressBar x:Name="ScanProgress" Grid.Row="2" Height="6" Margin="0,8,0,0"
                                 Minimum="0" Maximum="100" Value="0" />

                    <ListView x:Name="PoolList" Grid.Row="3" Margin="0,8,0,0">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="DNS" Width="130" DisplayMemberBinding="{Binding Ip}" />
                                <GridViewColumn Header="名称" Width="150" DisplayMemberBinding="{Binding Name}" />
                                <GridViewColumn Header="延迟(ms)" Width="76" DisplayMemberBinding="{Binding LatencyMs}" />
                                <GridViewColumn Header="状态" Width="66" DisplayMemberBinding="{Binding Status}" />
                                <GridViewColumn Header="成功/失败" Width="86" DisplayMemberBinding="{Binding Score}" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>
            </GroupBox>
        </Grid>

        <!-- 域名诊断 -->
        <Expander Grid.Row="2" Header="域名诊断（复用加速池解析与 TCP 竞速）" Margin="0,12,0,0" IsExpanded="False">
            <Grid Margin="10,8,10,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <WrapPanel Grid.Row="0">
                    <TextBlock Text="域名" VerticalAlignment="Center" />
                    <TextBox x:Name="DiagDomainBox" Width="200" Margin="6,0,0,0"
                             Text="github.com" VerticalContentAlignment="Center" />
                    <TextBlock Text="端口" VerticalAlignment="Center" Margin="12,0,6,0" />
                    <TextBox x:Name="DiagPortBox" Width="64" Text="443" VerticalContentAlignment="Center" />
                    <Button x:Name="DiagnoseButton" Content="开始诊断" Padding="10,4" Margin="10,0,0,0" />
                    <Button x:Name="CopyReportButton" Content="复制报告" Padding="10,4" Margin="6,0,0,0" />
                </WrapPanel>

                <TextBox x:Name="DiagReportBox" Grid.Row="1" Height="150" Margin="0,8,0,0"
                         IsReadOnly="True" TextWrapping="NoWrap" AcceptsReturn="True"
                         FontFamily="Consolas" FontSize="11" VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         Text="输入域名后点「开始诊断」：会先用加速池解析 A/AAAA，再对候选 IP 做一次 TCP 竞速。" />
            </Grid>
        </Expander>

        <!-- 参数设置 -->
        <Expander Grid.Row="3" Header="参数设置（修改后立即生效）" Margin="0,10,0,0" IsExpanded="False">
            <WrapPanel Margin="10,8,10,10">
                <StackPanel Orientation="Horizontal" Margin="0,0,18,8">
                    <TextBlock Text="竞速并发 IP 数" VerticalAlignment="Center" />
                    <TextBox x:Name="RaceMaxIpsBox" Width="52" Margin="6,0,0,0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,18,8">
                    <TextBlock Text="首连预算(ms)" VerticalAlignment="Center" />
                    <TextBox x:Name="BudgetBox" Width="60" Margin="6,0,0,0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,18,8">
                    <TextBlock Text="建连超时(ms)" VerticalAlignment="Center" />
                    <TextBox x:Name="RaceTimeoutBox" Width="60" Margin="6,0,0,0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,18,8">
                    <TextBlock Text="重赛轮数" VerticalAlignment="Center" />
                    <TextBox x:Name="RetryRoundsBox" Width="52" Margin="6,0,0,0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,18,8">
                    <TextBlock Text="扫描并发" VerticalAlignment="Center" />
                    <TextBox x:Name="ScanConcurrencyBox" Width="60" Margin="6,0,0,0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,18,8">
                    <TextBlock Text="扫描超时(ms)" VerticalAlignment="Center" />
                    <TextBox x:Name="ScanTimeoutBox" Width="60" Margin="6,0,0,0" />
                </StackPanel>
                <CheckBox x:Name="FallbackCheck" Content="候选全失败时用系统 DNS 兜底"
                          ToolTip="加速池解析出的 IP 全部连不上时，再用系统 DNS 试一次；关闭后直接返回 502"
                          VerticalAlignment="Center" Margin="0,0,18,8" />
                <CheckBox x:Name="AutoStartCheck" Content="开机自启" VerticalAlignment="Center"
                          Margin="0,0,18,8" />
                <StackPanel Orientation="Horizontal" Margin="0,0,18,8">
                    <TextBlock Text="关闭窗口时" VerticalAlignment="Center" />
                    <ComboBox x:Name="CloseActionBox" Width="140" Margin="6,0,0,0" />
                </StackPanel>
                <Button x:Name="RestoreTuningButton" Content="恢复默认参数" Padding="10,4" Margin="0,0,0,8" />
            </WrapPanel>
        </Expander>

        <!-- 统计与日志 -->
        <Grid Grid.Row="4" Margin="0,10,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock x:Name="StatsText" Grid.Row="0" TextWrapping="Wrap"
                       Text="请求 0 · 池胜 0 · 池败 0 · 直连 0 · 隧道 0 · 失败 0" />

            <WrapPanel Grid.Row="1" Margin="0,6,0,0">
                <TextBlock Text="日志" VerticalAlignment="Center" />
                <ComboBox x:Name="LogFilterBox" Width="110" Margin="6,0,0,0" />
                <Button x:Name="OpenLogDirButton" Content="打开日志目录" Padding="8,2" Margin="8,0,0,0" />
                <CheckBox x:Name="AutoScrollCheck" Content="自动滚动" IsChecked="True"
                          VerticalAlignment="Center" Margin="12,0,0,0" />
            </WrapPanel>

            <TextBox x:Name="LogBox" Grid.Row="2" Height="120" Margin="0,6,0,0" IsReadOnly="True"
                     FontFamily="Consolas" FontSize="11" TextWrapping="NoWrap"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
        </Grid>
    </Grid>
</Window>
